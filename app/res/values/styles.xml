<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#0a0a0c</color>
    <color name="black">#000000</color>
    <color name="accent">#f7d116</color>
    <!-- Dark only: same theme whatever the system setting is -->
    <style name="DeckTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
